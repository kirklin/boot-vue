{
  "name": "boot-vue",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Vue starter template with Tailwind CSS and shadcn-vue",
  "keywords": [
    "BootVue",
    "boot-vue",
    "vite",
    "tailwindcss",
    "shadcn-vue",
    "fast",
    "boot"
  ],
  "main": "src/main.ts",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npx husky",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@kirklin/logger": "catalog:frontend",
    "@kirklin/reset-css": "catalog:frontend",
    "@lucide/vue": "catalog:frontend",
    "@vue/devtools-api": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "class-variance-authority": "catalog:frontend",
    "cn": "catalog:frontend",
    "iso-639-1": "catalog:frontend",
    "nprogress": "catalog:frontend",
    "pinia": "catalog:frontend",
    "reka-ui": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "vue-router": "catalog:frontend"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@iconify-json/mdi": "catalog:dev",
    "@iconify-json/simple-icons": "catalog:dev",
    "@intlify/unplugin-vue-i18n": "catalog:build",
    "@kirklin/eslint-config": "catalog:dev",
    "@tailwindcss/vite": "catalog:build",
    "@types/node": "catalog:types",
    "@types/nprogress": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vitest/coverage-v8": "catalog:dev",
    "@vue/compiler-dom": "catalog:build",
    "@vue/test-utils": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-erasable-syntax-only": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "eslint-plugin-vuejs-accessibility": "catalog:dev",
    "husky": "catalog:dev",
    "jsdom": "catalog:build",
    "lint-staged": "catalog:dev",
    "shadcn-vue": "catalog:build",
    "tailwindcss": "catalog:build",
    "tw-animate-css": "catalog:build",
    "typescript": "catalog:dev",
    "unplugin-auto-import": "catalog:build",
    "unplugin-icons": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-inspect": "catalog:build",
    "vite-plugin-mcp": "catalog:build",
    "vite-plugin-pwa": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:build",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev"
  },
  "lint-staged": {
    "**/*": "eslint --fix"
  }
}
